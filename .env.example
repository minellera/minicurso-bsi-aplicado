# Copie este arquivo para `.env` e ajuste os valores conforme necessário:
#   cp .env.example .env
# O arquivo `.env` NÃO deve ser versionado (já está no .gitignore).

# Chave usada pelo Django para assinar sessões e cookies.
DJANGO_SECRET_KEY=troque-esta-chave-em-producao

# Modo de depuração: use True apenas em desenvolvimento.
DJANGO_DEBUG=True

# Hosts autorizados a servir a aplicação, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origens confiáveis para requisições POST (necessário em HTTPS/produção).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meu-dominio.com.br
